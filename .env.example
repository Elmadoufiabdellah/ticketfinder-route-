# Copy this file to .env and fill in your real values.
# Never commit the real .env file — it is excluded via .gitignore.

# Anthropic — powers the LLM orchestration layer that decides which
# function/tool to call. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the default model used for orchestration
CLAUDE_MODEL=claude-sonnet-5

# Kiwi / Tequila API — flight search (Function 4 -> Function 5)
KIWI_API_KEY=

# Directory for atomic state saves and snapshots
TF_STATE_DIR=outputs
